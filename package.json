{
	"name": "n8n-nodes-france-datagouv",
	"version": "0.1.0",
	"description": "Nœud n8n pour les API ouvertes de l'État français (data.gouv.fr) : Recherche d'Entreprises et Jours fériés",
	"license": "MIT",
	"homepage": "https://github.com/tsnaketech/n8n-nodes-france-datagouv#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"siren",
		"siret",
		"sirene",
		"entreprise",
		"france",
		"data.gouv.fr",
		"jours-feries",
		"calendrier"
	],
	"author": {
		"name": "tsnaketech",
		"email": "34743212+tsnaketech@users.noreply.github.com",
		"url": "https://github.com/tsnaketech"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsnaketech/n8n-nodes-france-datagouv.git"
	},
	"bugs": {
		"url": "https://github.com/tsnaketech/n8n-nodes-france-datagouv/issues"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc && gulp build:assets",
		"rebuild": "npm run clean && npm run build",
		"dev": "tsc --watch",
		"format": "prettier nodes package.json gulpfile.js --write",
		"format:check": "prettier nodes package.json gulpfile.js --check",
		"lint": "eslint nodes package.json",
		"lint:fix": "eslint nodes package.json --fix",
		"ci": "npm run format:check && npm run lint && npm run build",
		"prepack": "npm run rebuild"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"nodes": [
			"dist/nodes/FranceDataGouv/FranceDataGouv.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.5",
		"gulp": "^5.0.1",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"rimraf": "^6.1.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
